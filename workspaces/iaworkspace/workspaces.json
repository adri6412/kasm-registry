{
  "workspaces": [
    {
      "name": "dev_desktop_complete",
      "friendly_name": "Dev Desktop Plus",
      "description": "Ubuntu con VS Code, Cursor, Antigravity e Sudo",
      "image": "il-tuo-nome-utente/kasm-dev-desktop:latest",
      "cores": 2,
      "memory": 4096,
      "gpu_count": 0,
