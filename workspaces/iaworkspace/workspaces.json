      "categories": ["Development"],
      "enabled": true,
      "uncompressed_size_mb": 3000,
      "architecture": ["amd64"],
      "launch_config": {
        "container_config": {
          "user": "kasm_user",
          "shm_size": "512m"
        }
      }
    }
  ]
}
